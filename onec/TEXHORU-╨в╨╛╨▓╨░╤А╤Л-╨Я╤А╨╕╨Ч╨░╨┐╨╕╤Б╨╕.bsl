// Учебный пример для локальной базы 1С.
// Для production категорию следует вынести в отдельный справочник с собственным GUID.

Процедура ПриЗаписи(Отказ)

    Попытка
        ИмяКатегории = СокрЛП(Категория);
        Если ПустаяСтрока(ИмяКатегории) Тогда
            ИмяКатегории = "Без категории";
        КонецЕсли;

        // Для учебной конфигурации ID строится из имени.
        // В production передавай GUID отдельного справочника Категории.
        КатегорияID = "CAT::" + ИмяКатегории;
        КатегорияSlug = НРег(ИмяКатегории);
        КатегорияSlug = СтрЗаменить(КатегорияSlug, " ", "-");

        Категории = Новый Массив;
        КатегорияJSON = Новый Структура;
        КатегорияJSON.Вставить("oneCId", КатегорияID);
        КатегорияJSON.Вставить("name", ИмяКатегории);
        КатегорияJSON.Вставить("slug", КатегорияSlug);
        Категории.Добавить(КатегорияJSON);

        ТоварыJSON = Новый Массив;
        ТоварJSON = Новый Структура;
        ТоварJSON.Вставить("oneCId", Строка(Ссылка.УникальныйИдентификатор()));
        ТоварJSON.Вставить("sku", Артикул);
        ТоварJSON.Вставить("name", Наименование);
        ТоварJSON.Вставить("slug", Артикул);
        ТоварJSON.Вставить("brand", "Без бренда");
        ТоварJSON.Вставить("categoryOneCId", КатегорияID);
        ТоварJSON.Вставить("price", Цена);
        ТоварJSON.Вставить("stockQty", Остаток);
        ТоварыJSON.Добавить(ТоварJSON);

        Данные = Новый Структура;
        Данные.Вставить("categories", Категории);
        Данные.Вставить("products", ТоварыJSON);

        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Данные);
        ТелоJSON = ЗаписьJSON.Закрыть();

        Соединение = Новый HTTPСоединение("127.0.0.1", 3000);
        Запрос = Новый HTTPЗапрос("/api/integrations/1c/catalog");
        Запрос.Заголовки.Вставить("Content-Type", "application/json");
        Запрос.Заголовки.Вставить("x-1c-key", "local-dev-1c-key-change-before-production");
        Запрос.УстановитьТелоИзСтроки(ТелоJSON);

        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния = 200 Или Ответ.КодСостояния = 201 Тогда
            Сообщить("TEXHORU: товар синхронизирован");
        Иначе
            Сообщить("TEXHORU ошибка: " + Строка(Ответ.КодСостояния) + " " + Ответ.ПолучитьТелоКакСтроку());
        КонецЕсли;

    Исключение
        Сообщить("TEXHORU: ошибка соединения: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
