// TEXHORU / ОСНОВНАЯ УТ 10.3. Исходный модуль обычной формы; требует проверки метаданных в 1С.
// TEXHORU: модуль ОБЫЧНОЙ формы внешней обработки УТ 10.3, платформа 8.3.
// Реквизиты: ХостСайта (Строка), КлючAPI (Строка), ИдентификаторБазы (Строка),
// ПапкаОбмена (Строка), ТипЦен (СправочникСсылка.ТипыЦенНоменклатуры),
// ГруппаВыгрузки (СправочникСсылка.Номенклатура, необязательно), ПолнаяВыгрузка (Булево).
// Кнопка: «Обновить товары на сайте», действие ТЕХОРУОбновитьТоварыНажатие.
// ПапкаОбмена — отдельная постоянная папка для каждой пары база + сайт + группа + тип цен.
// Дополнительно: ЗакупочныйТипЦен (СправочникСсылка.ТипыЦенНоменклатуры).
// Кнопка цен: ТЕХОРУПрименитьРозничныеЦеныНажатие.
// Выгрузка каталога — только чтение 1С. Ни документы, ни цены, ни остатки в 1С не записываются.

Перем ТЕХОРУСостояние;
Перем ТЕХОРУРаботает;
Перем ТЕХОРУПовторы;
Перем ТЕХОРУЦеныРаботают;

Функция ТЕХОРУJSON(Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

Функция ТЕХОРУИзJSON(Текст)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Функция ТЕХОРУПуть(Имя)
    Возврат ПапкаОбмена + "\" + Имя;
КонецФункции

Процедура ТЕХОРУСохранитьСостояние()
    // Предыдущий checkpoint остаётся для восстановления при сбое диска.
    Основной = ТЕХОРУПуть("state.bin");
    Если ТЕХОРУФайлСуществует(Основной) Тогда
        КопироватьФайл(Основной, ТЕХОРУПуть("state.bak"));
    КонецЕсли;
    ЗначениеВФайл(Основной, ТЕХОРУСостояние);
КонецПроцедуры

Функция ТЕХОРУФайлСуществует(Имя)
    ПроверяемыйФайл = Новый Файл(Имя);
    Возврат ПроверяемыйФайл.Существует();
КонецФункции

Функция ТЕХОРУЧитатьПодпись(ID)
    Имя = ТЕХОРУПуть("items\" + ID + ".bin");
    Если Не ТЕХОРУФайлСуществует(Имя) Тогда Возврат ""; КонецЕсли;
    Попытка
        Возврат ЗначениеИзФайла(Имя);
    Исключение
        Возврат ""; // Повторная передача безопасна, если локальный кэш повреждён.
    КонецПопытки;
КонецФункции

Функция ТЕХОРУHTTP(Путь, Данные)
    Соединение = Новый HTTPСоединение(ХостСайта, 443, , , , 45,
        Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/api/integrations/1c/catalog-sync/" + Путь);
    Запрос.Заголовки.Вставить("x-1c-key", КлючAPI);
    Запрос.Заголовки.Вставить("x-1c-base-kind", "PRODUCTION");
    Запрос.Заголовки.Вставить("x-1c-base-id", ИдентификаторБазы);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.УстановитьТелоИзСтроки(ТЕХОРУJSON(Данные), КодировкаТекста.UTF8,
        ИспользованиеByteOrderMark.НеИспользовать);
    Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Если Ответ.КодСостояния = 200 Или Ответ.КодСостояния = 201 Тогда
        Возврат ТЕХОРУИзJSON(Ответ.ПолучитьТелоКакСтроку());
    КонецЕсли;
    Если Ответ.КодСостояния = 408 Или Ответ.КодСостояния = 429
        Или Ответ.КодСостояния >= 500 Тогда
        ВызватьИсключение "RETRY: HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    // Ошибки данных, доступа, конфликты сеанса требуют исправления, а не цикла.
    ВызватьИсключение "STOP: HTTP " + Строка(Ответ.КодСостояния)
        + ": " + Лев(Ответ.ПолучитьТелоКакСтроку(), 350);
КонецФункции

Функция ТЕХОРУПутьГруппы(Группа)
    Результат = "";
    Пока ЗначениеЗаполнено(Группа) Цикл
        Результат = СокрЛП(Группа.Наименование) + ?(Результат = "", "", " / " + Результат);
        Группа = Группа.Родитель;
    КонецЦикла;
    Возврат ?(Результат = "", "Без категории", Результат);
КонецФункции

Функция ТЕХОРУБренд(Имя)
    Текст = НРег(Имя);
    Если СтрНайти(Текст, "iphone") > 0 Или СтрНайти(Текст, "apple") > 0 Тогда Возврат "Apple"; КонецЕсли;
    Если СтрНайти(Текст, "samsung") > 0 Тогда Возврат "Samsung"; КонецЕсли;
    Если СтрНайти(Текст, "xiaomi") > 0 Или СтрНайти(Текст, "redmi") > 0 Или СтрНайти(Текст, "poco") > 0 Тогда Возврат "Xiaomi"; КонецЕсли;
    Если СтрНайти(Текст, "honor") > 0 Тогда Возврат "Honor"; КонецЕсли;
    Если СтрНайти(Текст, "huawei") > 0 Тогда Возврат "Huawei"; КонецЕсли;
    Возврат "Другие";
КонецФункции

Функция ТЕХОРУСледующаяПорция()
    // Курсор по ссылке, не OFFSET: не перечитываем предшествующие страницы.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 50
    |   Н.Ссылка КАК Товар, Н.Наименование КАК Имя, Н.Артикул КАК Артикул,
    |   Н.Родитель КАК Группа, Н.ПометкаУдаления КАК Удалён
    |ИЗ Справочник.Номенклатура КАК Н
    |ГДЕ НЕ Н.ЭтоГруппа И Н.Ссылка > &После";
    Запрос.УстановитьПараметр("После", ТЕХОРУСостояние.После);
    Если ЗначениеЗаполнено(ГруппаВыгрузки) Тогда
        Запрос.Текст = Запрос.Текст + " И Н.Ссылка В ИЕРАРХИИ(&Группа)";
        Запрос.УстановитьПараметр("Группа", ГруппаВыгрузки);
    КонецЕсли;
    Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО Н.Ссылка";
    Строки = Запрос.Выполнить().Выгрузить(); // <=50, никогда весь каталог.
    Если Строки.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
    Ссылки = Строки.ВыгрузитьКолонку("Товар");
    ПустаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

    // Одна выборка цен и одна остатков для текущих 50, без запроса на каждый SKU.
    ЗапросЦен = Новый Запрос;
    ЗапросЦен.Текст =
    "ВЫБРАТЬ Ц.Номенклатура КАК Товар, МАКСИМУМ(Ц.Цена) КАК Цена,
    |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ц.Цена) КАК ВариантовЦены
    |ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
    |   &Дата, ТипЦен = &ТипЦен И Номенклатура В (&Товары)
    |   И ХарактеристикаНоменклатуры = &Пустая) КАК Ц
    |СГРУППИРОВАТЬ ПО Ц.Номенклатура";
    ЗапросЦен.УстановитьПараметр("Дата", ТекущаяДата());
    ЗапросЦен.УстановитьПараметр("ТипЦен", ТипЦен);
    ЗапросЦен.УстановитьПараметр("Товары", Ссылки);
    ЗапросЦен.УстановитьПараметр("Пустая", ПустаяХарактеристика);
    Цены = Новый Соответствие;
    ВыборкаЦен = ЗапросЦен.Выполнить().Выбрать();
    Пока ВыборкаЦен.Следующий() Цикл
        Если ВыборкаЦен.ВариантовЦены > 1 Тогда
            ВызватьИсключение "STOP: Несколько базовых цен у " + Строка(ВыборкаЦен.Товар)
                + ". Уточните единицы измерения и валюту в обработке.";
        КонецЕсли;
        Цены.Вставить(ВыборкаЦен.Товар, ВыборкаЦен.Цена);
    КонецЦикла;
    ЗапросЗакупочных = Новый Запрос;
    ЗапросЗакупочных.Текст =
    "ВЫБРАТЬ Ц.Номенклатура КАК Товар, МАКСИМУМ(Ц.Цена) КАК Цена,
    |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ц.Цена) КАК ВариантовЦены
    |ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
    |   &Дата, ТипЦен = &ТипЦен И Номенклатура В (&Товары)
    |   И ХарактеристикаНоменклатуры = &Пустая) КАК Ц
    |СГРУППИРОВАТЬ ПО Ц.Номенклатура";
    ЗапросЗакупочных.УстановитьПараметр("Дата", ТекущаяДата());
    ЗапросЗакупочных.УстановитьПараметр("ТипЦен", ЗакупочныйТипЦен);
    ЗапросЗакупочных.УстановитьПараметр("Товары", Ссылки);
    ЗапросЗакупочных.УстановитьПараметр("Пустая", ПустаяХарактеристика);
    Закупочные = Новый Соответствие;
    ВыборкаЗакупочных = ЗапросЗакупочных.Выполнить().Выбрать();
    Пока ВыборкаЗакупочных.Следующий() Цикл
        Если ВыборкаЗакупочных.ВариантовЦены > 1 Тогда
            ВызватьИсключение "STOP: Несколько закупочных цен у " + Строка(ВыборкаЗакупочных.Товар)
                + ". Уточните единицы измерения и валюту в обработке.";
        КонецЕсли;
        Закупочные.Вставить(ВыборкаЗакупочных.Товар, ВыборкаЗакупочных.Цена);
    КонецЦикла;
    ЗапросОстатков = Новый Запрос;
    ЗапросОстатков.Текст =
    "ВЫБРАТЬ О.Номенклатура КАК Товар, СУММА(О.КоличествоОстаток) КАК Остаток
    |ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(
    |   , Номенклатура В (&Товары) И ХарактеристикаНоменклатуры = &Пустая) КАК О
    |СГРУППИРОВАТЬ ПО О.Номенклатура";
    ЗапросОстатков.УстановитьПараметр("Товары", Ссылки);
    ЗапросОстатков.УстановитьПараметр("Пустая", ПустаяХарактеристика);
    Остатки = Новый Соответствие;
    ВыборкаОстатков = ЗапросОстатков.Выполнить().Выбрать();
    Пока ВыборкаОстатков.Следующий() Цикл
        Остатки.Вставить(ВыборкаОстатков.Товар, ВыборкаОстатков.Остаток);
    КонецЦикла;

    Товары = Новый Массив;
    Категории = Новый Массив;
    Группы = Новый Соответствие;
    Подписи = Новый Массив;
    После = ТЕХОРУСостояние.После;
    Для Каждого СтрокаТовара Из Строки Цикл
        После = СтрокаТовара.Товар;
        ID = НРег(Строка(После.УникальныйИдентификатор()));
        Группа = СтрокаТовара.Группа;
        IDГруппы = ?(ЗначениеЗаполнено(Группа), НРег(Строка(Группа.УникальныйИдентификатор())), "00000000-0000-0000-0000-000000000000");
        Цена = Цены.Получить(После);
        Закупочная = Закупочные.Получить(После);
        Если Закупочная <> Неопределено И (Закупочная < 0 Или Закупочная <> Цел(Закупочная)) Тогда
            ВызватьИсключение "Недопустимая закупочная цена. Требуются целые рубли: " + Строка(После);
        КонецЕсли;
        Количество = Остатки.Получить(После);
        Если Цена = Неопределено Тогда Цена = 0; КонецЕсли;
        Если Количество = Неопределено Тогда Количество = 0; КонецЕсли;
        Если Цена <> Цел(Цена) Или Количество <> Цел(Количество) Тогда
            ВызватьИсключение "STOP: Дробная цена/остаток у " + Строка(После)
                + ". Эта обработка рассчитана на целые рубли и штучные товары.";
        КонецЕсли;
        // Характеристики не объединяются в родительский SKU; в этой версии только базовые позиции.
        Данные = Новый Структура;
        Данные.Вставить("oneCId", ID);
        Данные.Вставить("sku", "1C-" + ID);
        Данные.Вставить("slug", "1c-" + ID);
        Данные.Вставить("name", Лев(СокрЛП(СтрокаТовара.Имя), 500));
        Данные.Вставить("brand", ТЕХОРУБренд(СтрокаТовара.Имя));
        Данные.Вставить("categoryOneCId", IDГруппы);
        Данные.Вставить("price", Макс(0, Цел(Цена)));
        // Неопределено сериализуется как null: старая закупочная на сайте очищается.
        Данные.Вставить("costPrice", Закупочная);
        Данные.Вставить("stockQty", ?(СтрокаТовара.Удалён, 0, Макс(0, Цел(Количество))));
        Данные.Вставить("isDeleted", СтрокаТовара.Удалён);
        Если ЗначениеЗаполнено(СтрокаТовара.Артикул) Тогда
            Данные.Вставить("mpn", Лев(СокрЛП(СтрокаТовара.Артикул), 100));
        КонецЕсли;
        ИмяГруппы = ТЕХОРУПутьГруппы(Группа);
        Если СтрДлина(ИмяГруппы) > 500 Тогда
            ВызватьИсключение "STOP: Путь категории длиннее 500 символов. Укоротите названия групп.";
        КонецЕсли;
        // Имя группы тоже входит в подпись: переименование не теряется при DELTA.
        Подпись = ТЕХОРУJSON(Новый Структура("product,categoryName", Данные, ИмяГруппы));
        Если Не ТЕХОРУСостояние.Полная И ТЕХОРУЧитатьПодпись(ID) = Подпись Тогда Продолжить; КонецЕсли;
        Товары.Добавить(Данные);
        Подписи.Добавить(Новый Структура("id,value", ID, Подпись));
        Если Группы.Получить(IDГруппы) = Неопределено Тогда
            Категории.Добавить(Новый Структура("oneCId,name,slug", IDГруппы, ИмяГруппы, "1c-" + IDГруппы));
            Группы.Вставить(IDГруппы, Истина);
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("products,categories,signatures,after,scanned", Товары, Категории,
        Подписи, После, Строки.Количество());
КонецФункции

Процедура ТЕХОРУОбновитьТоварыНажатие(Кнопка)
    Если ТЕХОРУРаботает = Истина Или ТЕХОРУЦеныРаботают = Истина Тогда Возврат; КонецЕсли;
    Попытка
        Если ПустаяСтрока(ХостСайта) Или СтрНайти(ХостСайта, "/") > 0
            Или СтрНайти(ХостСайта, ":") > 0 Тогда
            ВызватьИсключение "Укажите только домен магазина без https:// и без порта.";
        КонецЕсли;
        Если СтрДлина(КлючAPI) < 24 Или ПустаяСтрока(ИдентификаторБазы)
            Или ПустаяСтрока(ПапкаОбмена) Или Не ЗначениеЗаполнено(ТипЦен) Тогда
            ВызватьИсключение "Заполните ключ, ID базы, папку обмена и тип розничных цен.";
        КонецЕсли;
        ОсновнаяТЕХОРУПроверитьТипыЦен();
        СоздатьКаталог(ПапкаОбмена);
        СоздатьКаталог(ТЕХОРУПуть("items"));
        Основной = ТЕХОРУПуть("state.bin");
        ПараметрыОбмена = ХостСайта + "|" + ИдентификаторБазы + "|"
            + Строка(ТипЦен.УникальныйИдентификатор()) + "|"
            + Строка(ЗакупочныйТипЦен.УникальныйИдентификатор()) + "|"
            + ?(ЗначениеЗаполнено(ГруппаВыгрузки), Строка(ГруппаВыгрузки.УникальныйИдентификатор()), "ALL");
        Если ТЕХОРУФайлСуществует(ТЕХОРУПуть("initialized.bin")) Тогда
            Если ЗначениеИзФайла(ТЕХОРУПуть("initialized.bin")) <> ПараметрыОбмена Тогда
                ВызватьИсключение "Используйте отдельную папку обмена для других параметров.";
            КонецЕсли;
        КонецЕсли;
        Если ТЕХОРУФайлСуществует(Основной) Тогда
            ТЕХОРУСостояние = ЗначениеИзФайла(Основной);
            Если ТЕХОРУСостояние.Параметры <> ПараметрыОбмена Тогда
                ВызватьИсключение "Параметры изменились. Используйте отдельную папку обмена для другого сайта/группы/типа цен.";
            КонецЕсли;
        Иначе
            ТЕХОРУСостояние = Новый Структура;
            ТЕХОРУСостояние.Вставить("ID", НРег(Строка(Новый УникальныйИдентификатор)));
            ТЕХОРУСостояние.Вставить("Параметры", ПараметрыОбмена);
            ТЕХОРУСостояние.Вставить("Полная", ПолнаяВыгрузка Или Не ТЕХОРУФайлСуществует(ТЕХОРУПуть("initialized.bin")));
            ТЕХОРУСостояние.Вставить("После", Справочники.Номенклатура.ПустаяСсылка());
            ТЕХОРУСостояние.Вставить("Пакет", 0);
            ТЕХОРУСостояние.Вставить("Просмотрено", 0);
            ТЕХОРУСостояние.Вставить("Отправлено", 0);
            ТЕХОРУСостояние.Вставить("Этап", "START");
            ТЕХОРУСостояние.Вставить("Ожидает", Неопределено);
            ТЕХОРУСохранитьСостояние();
        КонецЕсли;
        ТЕХОРУПовторы = 0;
        ТЕХОРУРаботает = Истина;
        Сообщить("TEXHORU: начинаем/продолжаем выгрузку по 50 товаров. 1С не изменяется.");
        ПодключитьОбработчикОжидания("ТЕХОРУШагОбмена", 1, Истина);
    Исключение
        Сообщить("TEXHORU: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ТЕХОРУШагОбмена() Экспорт
    Если ТЕХОРУРаботает <> Истина Тогда Возврат; КонецЕсли;
    Попытка
        Если ТЕХОРУСостояние.Этап = "START" Тогда
            Ответ = ТЕХОРУHTTP("start", Новый Структура("sessionId,clientId,mode",
                ТЕХОРУСостояние.ID, ИдентификаторБазы, ?(ТЕХОРУСостояние.Полная, "FULL", "DELTA")));
            Если Ответ.status <> "RUNNING" Тогда ВызватьИсключение "STOP: Сеанс закрыт. См. инструкцию восстановления."; КонецЕсли;
            ТЕХОРУСостояние.Этап = "BATCH";
            ТЕХОРУСохранитьСостояние();
        ИначеЕсли ТЕХОРУСостояние.Этап = "FINISH" Тогда
            ТЕХОРУHTTP(ТЕХОРУСостояние.ID + "/finish", Новый Структура);
            ЗначениеВФайл(ТЕХОРУПуть("initialized.bin"), ПараметрыОбменаИзСостояния());
            Сообщить("TEXHORU: готово. Проверено " + Строка(ТЕХОРУСостояние.Просмотрено)
                + ", отправлено " + Строка(ТЕХОРУСостояние.Отправлено) + ".");
            УдалитьФайлы(ТЕХОРУПуть("state.bin"));
            УдалитьФайлы(ТЕХОРУПуть("state.bak"));
            ТЕХОРУРаботает = Ложь;
            Возврат;
        Иначе
            Если ТЕХОРУСостояние.Ожидает = Неопределено Тогда
                ТЕХОРУСостояние.Ожидает = ТЕХОРУСледующаяПорция();
                Если ТЕХОРУСостояние.Ожидает = Неопределено Тогда
                    ТЕХОРУСостояние.Этап = "FINISH";
                    ТЕХОРУСохранитьСостояние();
                    ПодключитьОбработчикОжидания("ТЕХОРУШагОбмена", 1, Истина);
                    Возврат;
                КонецЕсли;
                ТЕХОРУСохранитьСостояние(); // payload и курсор ДО первого сетевого запроса.
            КонецЕсли;
            Порция = ТЕХОРУСостояние.Ожидает;
            Если Порция.products.Количество() > 0 Тогда
                Ответ = ТЕХОРУHTTP(ТЕХОРУСостояние.ID + "/batch", Новый Структура(
                    "batch,categories,products", ТЕХОРУСостояние.Пакет, Порция.categories, Порция.products));
                Если Ответ.nextBatch <> ТЕХОРУСостояние.Пакет + 1 Тогда
                    ВызватьИсключение "STOP: Сервер вернул неожиданный номер пакета.";
                КонецЕсли;
                Для Каждого Подпись Из Порция.signatures Цикл
                    ЗначениеВФайл(ТЕХОРУПуть("items\" + Подпись.id + ".bin"), Подпись.value);
                КонецЦикла;
                ТЕХОРУСостояние.Пакет = Ответ.nextBatch;
                ТЕХОРУСостояние.Отправлено = ТЕХОРУСостояние.Отправлено + Порция.products.Количество();
            КонецЕсли;
            ТЕХОРУСостояние.После = Порция.after;
            ТЕХОРУСостояние.Просмотрено = ТЕХОРУСостояние.Просмотрено + Порция.scanned;
            ТЕХОРУСостояние.Ожидает = Неопределено;
            ТЕХОРУСохранитьСостояние();
            Состояние("TEXHORU: проверено " + Строка(ТЕХОРУСостояние.Просмотрено)
                + ", отправлено " + Строка(ТЕХОРУСостояние.Отправлено));
        КонецЕсли;
        ТЕХОРУПовторы = 0;
        // Неблокирующая пауза: обработчик отдаёт управление форме между пакетами.
        ПодключитьОбработчикОжидания("ТЕХОРУШагОбмена", 1, Истина);
    Исключение
        Ошибка = ОписаниеОшибки();
        Если СтрНайти(Ошибка, "STOP:") > 0 Тогда
            ТЕХОРУРаботает = Ложь;
            Сообщить("TEXHORU: остановлено. " + Ошибка);
            Возврат;
        КонецЕсли;
        ТЕХОРУПовторы = ТЕХОРУПовторы + 1;
        Если ТЕХОРУПовторы > 5 Тогда
            ТЕХОРУРаботает = Ложь;
            Сообщить("TEXHORU: связь недоступна. Прогресс сохранён. Нажмите кнопку позже для продолжения. " + Ошибка);
            Возврат;
        КонецЕсли;
        // 2, 4, 8, 16, 32 секунды; 429 никогда не вызывает частый цикл.
        Задержка = 2;
        Для Номер = 2 По ТЕХОРУПовторы Цикл Задержка = Задержка * 2; КонецЦикла;
        Сообщить("TEXHORU: повтор через " + Строка(Задержка) + " сек. " + Ошибка);
        ПодключитьОбработчикОжидания("ТЕХОРУШагОбмена", Задержка, Истина);
    КонецПопытки;
КонецПроцедуры

Функция ПараметрыОбменаИзСостояния()
    Возврат ТЕХОРУСостояние.Параметры;
КонецФункции

Процедура ТЕХОРУОстановитьВыгрузкуНажатие(Кнопка)
    ТЕХОРУЦеныРаботают = Ложь;
    ОтключитьОбработчикОжидания("ТЕХОРУШагРозничныхЦен");
    ТЕХОРУРаботает = Ложь;
    ОтключитьОбработчикОжидания("ТЕХОРУШагОбмена");
    Сообщить("Выгрузка приостановлена. Следующий запуск продолжит с сохранённого пакета.");
КонецПроцедуры


Процедура ОсновнаяТЕХОРУПроверитьТипыЦен()
    Если Не ЗначениеЗаполнено(ТипЦен) Или Не ЗначениеЗаполнено(ЗакупочныйТипЦен)
        Или ТипЦен = ЗакупочныйТипЦен Тогда
        ВызватьИсключение "Выберите разные существующие типы цен Розничная и Закупочная";
    КонецЕсли;
    Если НРег(СокрЛП(ТипЦен.Наименование)) <> "розничная"
        Или НРег(СокрЛП(ЗакупочныйТипЦен.Наименование)) <> "закупочная"
        Или ТипЦен.ПометкаУдаления Или ЗакупочныйТипЦен.ПометкаУдаления Тогда
        ВызватьИсключение "Неверные типы цен. Новые типы автоматически не создаются";
    КонецЕсли;
    КодРозницы = СокрЛП(ТипЦен.ВалютаЦены.Код);
    КодЗакупки = СокрЛП(ЗакупочныйТипЦен.ВалютаЦены.Код);
    Если (КодРозницы <> "643" И ВРег(КодРозницы) <> "RUB")
        Или (КодЗакупки <> "643" И ВРег(КодЗакупки) <> "RUB") Тогда
        ВызватьИсключение "Для обмена нужны цены в рублях. Конвертация не выполняется";
    КонецЕсли;
КонецПроцедуры

Процедура ОсновнаяТЕХОРУПроверитьЗакупочную(Номенклатура, НоваяЦена)
    Закупка = ОсновнаяТЕХОРУТекущаяЦена(Номенклатура, ЗакупочныйТипЦен);
    Если ЗначениеЗаполнено(Закупка.Характеристика) Или Закупка.Цена < 0
        Или Закупка.Цена <> Цел(Закупка.Цена) Или НоваяЦена < Закупка.Цена Тогда
        ВызватьИсключение "Запись ниже актуальной закупочной или неоднозначная закупочная запрещена";
    КонецЕсли;
КонецПроцедуры

Процедура ТЕХОРУПрименитьРозничныеЦеныНажатие(Кнопка)
    Если ТЕХОРУРаботает = Истина Или ТЕХОРУЦеныРаботают = Истина Тогда Возврат; КонецЕсли;
    Попытка
        ОсновнаяТЕХОРУПроверитьТипыЦен();
        Если ПустаяСтрока(ИдентификаторБазы) Тогда ВызватьИсключение "Не указан ID основной базы"; КонецЕсли;
        ТЕХОРУЦеныРаботают = Истина;
        ПодключитьОбработчикОжидания("ТЕХОРУШагРозничныхЦен", 1, Истина);
    Исключение
        Сообщить("TEXHORU: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ТЕХОРУШагРозничныхЦен() Экспорт
    Если ТЕХОРУЦеныРаботают <> Истина Тогда Возврат; КонецЕсли;
    Попытка
        Итог = ОсновнаяТЕХОРУПолучитьЦеныДляАгента(ХостСайта, КлючAPI);
        Сообщить("TEXHORU: обновлено " + Строка(Итог.applied) + ", ошибок " + Строка(Итог.failed));
        Если Итог.ok <> Истина Или Итог.processed = 0 Тогда
            ТЕХОРУЦеныРаботают = Ложь;
            Возврат;
        КонецЕсли;
        ПодключитьОбработчикОжидания("ТЕХОРУШагРозничныхЦен", 1, Истина);
    Исключение
        ТЕХОРУЦеныРаботают = Ложь;
        Сообщить("TEXHORU: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Функция ОсновнаяТЕХОРУВJSON(Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции
Функция ОсновнаяТЕХОРУИзJSON(ТекстJSON)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции
Функция ОсновнаяТЕХОРУHTTP(Хост, КлючAPI, Метод, Путь, Тело = Неопределено)
    Если ПустаяСтрока(СокрЛП(Хост)) Тогда
        ВызватьИсключение "Укажи HTTPS-хост TEXHORU, без https://";
    КонецЕсли;
    Если ПустаяСтрока(СокрЛП(КлючAPI)) Тогда
        ВызватьИсключение "Не указан ONE_C_API_KEY";
    КонецЕсли;
    // Не передавай сюда полный URL, только хост.
    Если СтрНайти(Хост, "/") > 0 Или СтрНайти(Хост, ":") > 0 Тогда
        ВызватьИсключение "Хост должен быть без схемы и пути";
    КонецЕсли;
    Соединение = Новый HTTPСоединение(
        Хост, 443, "", "", Неопределено, 40, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/api/" + Путь);
    Запрос.Заголовки.Вставить("x-1c-key", КлючAPI);
    Запрос.Заголовки.Вставить("x-1c-base-kind", "PRODUCTION");
    Запрос.Заголовки.Вставить("x-1c-base-id", ИдентификаторБазы);
    Запрос.Заголовки.Вставить("ngrok-skip-browser-warning", "true");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Если Тело <> Неопределено Тогда
        Запрос.УстановитьТелоИзСтроки(ОсновнаяТЕХОРУВJSON(Тело), КодировкаТекста.UTF8);
    КонецЕсли;
    Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        ВызватьИсключение "TEXHORU HTTP " + Строка(Ответ.КодСостояния)
            + ": " + Лев(Ответ.ПолучитьТелоКакСтроку(), 600);
    КонецЕсли;
    Возврат ОсновнаяТЕХОРУИзJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция ОсновнаяТЕХОРУТипЦены()
    ОсновнаяТЕХОРУПроверитьТипыЦен();
    Возврат ТипЦен;
КонецФункции

Функция ОсновнаяТЕХОРУНоменклатура(СтрокаGUID)
    Попытка
        Ссылка = Справочники.Номенклатура.ПолучитьСсылку(
            Новый УникальныйИдентификатор(СтрокаGUID));
    Исключение
        ВызватьИсключение "Некорректный GUID номенклатуры";
    КонецПопытки;
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "Номенклатура по GUID не найдена в основной 1С";
    КонецЕсли;
    Если Объект.ЭтоГруппа Или Объект.ПометкаУдаления Тогда
        ВызватьИсключение "Группа или удалённая номенклатура: запись запрещена";
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

// Читаем только ОДНУ однозначную цену по выбранному типу.
// Если одна номенклатура имеет несколько характеристик, требуется
// явный GUID характеристики в контракте — ничего автоматически не выбираем.
Функция ОсновнаяТЕХОРУТекущаяЦена(Номенклатура, ТипЦены)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Цены.Цена КАК Цена,
    |    Цены.ХарактеристикаНоменклатуры КАК Характеристика
    |ИЗ
    |    РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
    |        &Момент,
    |        Номенклатура = &Номенклатура И ТипЦен = &ТипЦен) КАК Цены";
    Запрос.УстановитьПараметр("Момент", ТекущаяДата());
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("ТипЦен", ТипЦены);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Цена выбранного типа в 1С ещё не установлена";
    КонецЕсли;
    Результат = Новый Структура("Цена,Характеристика",
        Выборка.Цена, Выборка.Характеристика);
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "Несколько характеристик товара. Выбери одну явно";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ОсновнаяТЕХОРУПрименитьОднуЦену(Изменение, ТипЦены)
    Если Не Изменение.Свойство("id")
        Или Не Изменение.Свойство("oneCId")
        Или Не Изменение.Свойство("expectedPrice")
        Или Не Изменение.Свойство("targetPrice")
        Или Не Изменение.Свойство("currency") Тогда
        ВызватьИсключение "Неполное сообщение об изменении цены";
    КонецЕсли;
    Если Изменение.currency <> "RUB" Тогда
        ВызватьИсключение "Разрешены только рубли";
    КонецЕсли;
    Если ТипЗнч(Изменение.expectedPrice) <> Тип("Число")
        Или ТипЗнч(Изменение.targetPrice) <> Тип("Число")
        Или Изменение.expectedPrice <= 0
        Или Изменение.targetPrice <= 0
        Или Изменение.targetPrice > 5000000
        Или Изменение.targetPrice <> Цел(Изменение.targetPrice)
        Или Изменение.expectedPrice <> Цел(Изменение.expectedPrice) Тогда
        ВызватьИсключение "Недопустимая цена";
    КонецЕсли;
    Если Не Изменение.Свойство("baseKind") Или Изменение.baseKind <> "PRODUCTION"
        Или Не Изменение.Свойство("baseId") Или Изменение.baseId <> ИдентификаторБазы
        Или Не Изменение.Свойство("retailPriceType") Или Изменение.retailPriceType <> "Розничная"
        Или Не Изменение.Свойство("purchasePriceType") Или Изменение.purchasePriceType <> "Закупочная" Тогда
        ВызватьИсключение "Сообщение другой базы или другого типа цен: запись запрещена";
    КонецЕсли;
    Номенклатура = ОсновнаяТЕХОРУНоменклатура(Изменение.oneCId);
    ОсновнаяТЕХОРУПроверитьЗакупочную(Номенклатура, Изменение.targetPrice);
    Текущая = ОсновнаяТЕХОРУТекущаяЦена(Номенклатура, ТипЦены);
    Если ЗначениеЗаполнено(Текущая.Характеристика) Тогда
        ВызватьИсключение "Для товара с характеристикой требуется отдельный адаптер";
    КонецЕсли;
    // Повтор после потери HTTP-квитанции: если цена уже установлена,
    // не создаём повторный документ.
    Если Текущая.Цена = Изменение.targetPrice Тогда
        Возврат Изменение.targetPrice;
    КонецЕсли;
    Если Текущая.Цена <> Изменение.expectedPrice Тогда
        ВызватьИсключение "Конфликт: в 1С уже другая цена ("
            + Строка(Текущая.Цена) + "), ожидалось "
            + Строка(Изменение.expectedPrice);
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        // Внутри транзакции повторно проверяем актуальную закупочную и розничную.
        ОсновнаяТЕХОРУПроверитьЗакупочную(Номенклатура, Изменение.targetPrice);
        Контроль = ОсновнаяТЕХОРУТекущаяЦена(Номенклатура, ТипЦены);
        Если Контроль.Цена <> Изменение.expectedPrice Или ЗначениеЗаполнено(Контроль.Характеристика) Тогда
            ВызватьИсключение "Цена 1С изменилась во время обмена";
        КонецЕсли;

        ДокументЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
        ДокументЦен.Дата = ТекущаяДата();
        ДокументЦен.Комментарий = "TEXHORU: " + Изменение.id;
        СтрокаТипа = ДокументЦен.ТипыЦен.Добавить();
        СтрокаТипа.ТипЦен = ТипЦены;

        Товар = ДокументЦен.Товары.Добавить();
        Товар.Номенклатура = Номенклатура;
        Товар.ХарактеристикаНоменклатуры = Контроль.Характеристика;
        Товар.ТипЦен = ТипЦены;
        // УТ проверяет способ расчёта именно в строке Товары.
        // При программном добавлении строки он не переносится из типа цены автоматически.
        Товар.СпособРасчетаЦены = ТипЦены.СпособРасчетаЦены;
        Товар.Цена = Изменение.targetPrice;
        Товар.Валюта = ТипЦены.ВалютаЦены;
        Товар.ЕдиницаИзмерения = Номенклатура.ЕдиницаХраненияОстатков;
        Товар.ИндексСтрокиТаблицыЦен = 0;

        // Только если документ штатно проводится. В случае ошибки делаем откат.
        ДокументЦен.Записать(РежимЗаписиДокумента.Проведение);
        Проверка = ОсновнаяТЕХОРУТекущаяЦена(Номенклатура, ТипЦены);
        Если Проверка.Цена <> Изменение.targetPrice Тогда
            ВызватьИсключение "Документ проведён, но розничная цена не подтверждена";
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Изменение.targetPrice;
КонецФункции

Функция ОсновнаяТЕХОРУПолучитьЦеныДляАгента(Хост, КлючAPI) Экспорт
    ОтветОбласти = ОсновнаяТЕХОРУHTTP(Хост, КлючAPI, "GET",
        "integrations/1c/price-sync/scope");
    Область = ОтветОбласти;
    Если ТипЗнч(ОтветОбласти) = Тип("Структура") Тогда
        Если Не ОтветОбласти.Свойство("value", Область) Тогда
            ВызватьИсключение "API scope: отсутствует массив value";
        КонецЕсли;
    КонецЕсли;
    Если ТипЗнч(Область) <> Тип("Массив") Тогда
        ВызватьИсключение "API scope: ожидался массив";
    КонецЕсли;
    Если Область.Количество() > 30 Тогда
        ВызватьИсключение "Неправильный или слишком большой набор разрешённых товаров";
    КонецЕсли;
    Разрешённые = Новый Соответствие;
    Для Каждого СтрокаОбласти Из Область Цикл
        // Проверка каждого GUID по локальной номенклатуре делается при записи.
        Разрешённые.Вставить(СтрокаОбласти.oneCId, Истина);
    КонецЦикла;
    Итог = Новый Структура("protocolVersion,ok,applied,failed,processed,batches", 2, Истина, 0, 0, 0, 0);
    // Не более 30 позиций за сеанс. При ошибке останавливаем пакеты,
    // чтобы оставшийся PENDING не повторялся в этом же сеансе.
    Для НомерПакета = 1 По 3 Цикл
        Пакет = ОсновнаяТЕХОРУHTTP(Хост, КлючAPI, "GET",
            "integrations/1c/price-sync/pending");
        Если Не Пакет.Свойство("items") Тогда
            ВызватьИсключение "Неправильная очередь розничных цен";
        КонецЕсли;
        Если ТипЗнч(Пакет.items) <> Тип("Массив") Тогда
            ВызватьИсключение "Очередь items должна быть массивом";
        КонецЕсли;
        Если Пакет.items.Количество() > 10 Тогда
            ВызватьИсключение "Пакет содержит более 10 изменений";
        КонецЕсли;
        Если Пакет.items.Количество() = 0 Тогда
            Прервать;
        КонецЕсли;
        Квитанции = Новый Массив;
        Для Каждого Изменение Из Пакет.items Цикл
            Квитанция = Новый Структура("id", Изменение.id);
            Попытка
                Если Разрешённые.Получить(Изменение.oneCId) <> Истина Тогда
                    ВызватьИсключение "GUID товара отсутствует в разрешённой группе";
                КонецЕсли;
                ПодтвержденнаяЦена = ОсновнаяТЕХОРУПрименитьОднуЦену(
                    Изменение, ОсновнаяТЕХОРУТипЦены());
                Квитанция.Вставить("appliedPrice", ПодтвержденнаяЦена);
            Исключение
                Квитанция.Вставить("error", Лев(ОписаниеОшибки(), 950));
            КонецПопытки;
            Квитанции.Добавить(Квитанция);
        КонецЦикла;
        // Успех считаем только после подтверждения сервером, а не по числу попыток.
        ОтветКвитанций = ОсновнаяТЕХОРУHTTP(Хост, КлючAPI, "POST",
            "integrations/1c/price-sync/receipts", Новый Структура("items", Квитанции));
        Если Не ОтветКвитанций.Свойство("results") Тогда
            ВызватьИсключение "Сервер не подтвердил квитанции";
        КонецЕсли;
        Если ТипЗнч(ОтветКвитанций.results) <> Тип("Массив") Тогда
            ВызватьИсключение "Неверный ответ на квитанции";
        КонецЕсли;
        Если ОтветКвитанций.results.Количество() <> Квитанции.Количество() Тогда
            ВызватьИсключение "Сервер подтвердил не все квитанции";
        КонецЕсли;
        Для Индекс = 0 По Квитанции.Количество() - 1 Цикл
            Результат = ОтветКвитанций.results[Индекс];
            Если Результат.id <> Квитанции[Индекс].id Тогда
                ВызватьИсключение "Идентификатор квитанции не совпал";
            КонецЕсли;
            Если Результат.status = "DELIVERED" И Не Квитанции[Индекс].Свойство("error") Тогда
                Итог.applied = Итог.applied + 1;
            Иначе
                Итог.failed = Итог.failed + 1;
            КонецЕсли;
            Итог.processed = Итог.processed + 1;
        КонецЦикла;
        Итог.batches = Итог.batches + 1;
        Если Итог.failed > 0 Тогда
            Итог.ok = Ложь;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Возврат Итог;
КонецФункции

