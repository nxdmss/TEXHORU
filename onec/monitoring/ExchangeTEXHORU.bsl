// Общий модуль ОбменTEXHORU: Сервер = Да, Вызов сервера = Нет.
// Только для учебной конфигурации со справочником Товары.
// Настрой реквизиты и регистр по docs/windows-1c-monitoring.md.

Функция КаталогОбмена() Экспорт
    КатегорииJSON = Новый Массив;
    ТоварыJSON = Новый Массив;
    ИзвестныеКатегории = Новый Соответствие;
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Товары ГДЕ НЕ ПометкаУдаления");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Товар = Выборка.Ссылка.ПолучитьОбъект();
        Если Товар.Метаданные().Иерархический Тогда
            Если Товар.ЭтоГруппа Тогда Продолжить; КонецЕсли;
        КонецЕсли;
        ИмяКатегории = СокрЛП(Строка(РеквизитИли(Товар, "Категория", "Без категории")));
        Если ПустаяСтрока(ИмяКатегории) Тогда ИмяКатегории = "Без категории"; КонецЕсли;
        КатегорияID = "CAT::" + ИмяКатегории;
        Если ИзвестныеКатегории.Получить(КатегорияID) = Неопределено Тогда
            Категория = Новый Структура;
            Категория.Вставить("oneCId", КатегорияID);
            Категория.Вставить("name", ИмяКатегории);
            Категория.Вставить("slug", НРег(СтрЗаменить(ИмяКатегории, " ", "-")));
            КатегорииJSON.Добавить(Категория);
            ИзвестныеКатегории.Вставить(КатегорияID, Истина);
        КонецЕсли;
        ID = Строка(Товар.Ссылка.УникальныйИдентификатор());
        Артикул = СокрЛП(Строка(РеквизитИли(Товар, "Артикул", "")));
        Если ПустаяСтрока(Артикул) Тогда Артикул = "1C-" + ID; КонецЕсли;
        Данные = Новый Структура;
        Данные.Вставить("oneCId", ID);
        Данные.Вставить("sku", Артикул);
        Данные.Вставить("slug", Артикул);
        Данные.Вставить("name", Товар.Наименование);
        Данные.Вставить("brand", Строка(РеквизитИли(Товар, "Бренд", "Без бренда")));
        Данные.Вставить("categoryOneCId", КатегорияID);
        Данные.Вставить("price", Окр(РеквизитИли(Товар, "Цена", 0), 0));
        Данные.Вставить("stockQty", Окр(РеквизитИли(Товар, "Остаток", 0), 0));
        Если Товар.Метаданные().Реквизиты.Найти("Себестоимость") <> Неопределено Тогда
            Данные.Вставить("costPrice", Окр(Товар["Себестоимость"], 0));
        КонецЕсли;
        ДобавитьЕслиЗаполнено(Данные, "gtin", РеквизитИли(Товар, "Штрихкод", ""));
        ДобавитьЕслиЗаполнено(Данные, "mpn", РеквизитИли(Товар, "ЗаводскойАртикул", ""));
        Характеристики = Новый Структура;
        ДобавитьЕслиЗаполнено(Характеристики, "model", РеквизитИли(Товар, "Модель", ""));
        ДобавитьЕслиЗаполнено(Характеристики, "storage", РеквизитИли(Товар, "Память", ""));
        ДобавитьЕслиЗаполнено(Характеристики, "ram", РеквизитИли(Товар, "ОЗУ", ""));
        ДобавитьЕслиЗаполнено(Характеристики, "color", РеквизитИли(Товар, "Цвет", ""));
        ДобавитьЕслиЗаполнено(Характеристики, "sim", РеквизитИли(Товар, "ТипSIM", ""));
        Данные.Вставить("attributes", Характеристики);
        ТоварыJSON.Добавить(Данные);
    КонецЦикла;
    Возврат Новый Структура("categories,products", КатегорииJSON, ТоварыJSON);
КонецФункции

Функция РеквизитИли(Объект, Имя, ПоУмолчанию)
    Если Объект.Метаданные().Реквизиты.Найти(Имя) = Неопределено Тогда Возврат ПоУмолчанию; КонецЕсли;
    Возврат Объект[Имя];
КонецФункции

Процедура ДобавитьЕслиЗаполнено(Объект, Ключ, Значение)
    Если ЗначениеЗаполнено(Значение) Тогда Объект.Вставить(Ключ, Строка(Значение)); КонецЕсли;
КонецПроцедуры

Функция ВJSON(Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(СтрокаJSON)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Процедура ЗаписатьФайлJSON(ИмяФайла, Данные)
    СоздатьКаталог("C:\TEXHORU-Exchange");
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(ВJSON(Данные));
    Документ.Записать(ИмяФайла, КодировкаТекста.UTF8);
КонецПроцедуры

Функция ПрочитатьФайлJSON(ИмяФайла)
    Документ = Новый ТекстовыйДокумент;
    Документ.Прочитать(ИмяФайла, КодировкаТекста.UTF8);
    Возврат ИзJSON(Документ.ПолучитьТекст());
КонецФункции

Функция ВыгрузитьКаталогВФайл() Экспорт
    Данные = КаталогОбмена();
    ЗаписатьФайлJSON("C:\TEXHORU-Exchange\catalog.json", Данные);
    Возврат "Каталог: C:\TEXHORU-Exchange\catalog.json. Товаров: " + Строка(Данные.products.Количество());
КонецФункции

Функция ЗапросКСайту(Метод, Путь, Ключ, Данные = Неопределено)
    Если ПустаяСтрока(СокрЛП(Ключ)) Тогда ВызватьИсключение "Укажи ключ из server/.env.local (ONE_C_API_KEY)"; КонецЕсли;
    // Локальный HTTP, когда 1С и TEXHORU работают на одном Windows-компьютере.
    // Для удалённого сервера нужен отдельный HTTPS-адаптер и проверка сертификата.
    Соединение = Новый HTTPСоединение("127.0.0.1", 3000, "", "", Неопределено, 30);
    Запрос = Новый HTTPЗапрос("/api/" + Путь);
    Запрос.Заголовки.Вставить("x-1c-key", Ключ);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Если Данные <> Неопределено Тогда Запрос.УстановитьТелоИзСтроки(ВJSON(Данные), КодировкаТекста.UTF8); КонецЕсли;
    Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        ВызватьИсключение "TEXHORU HTTP " + Строка(Ответ.КодСостояния) + ": " + Лев(Ответ.ПолучитьТелоКакСтроку(), 1500);
    КонецЕсли;
    Возврат ИзJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция ВыгрузитьКаталогHTTP(Ключ) Экспорт
    Данные = КаталогОбмена();
    ПакетТоваров = Новый Массив;
    Для Каждого Товар Из Данные.products Цикл
        ПакетТоваров.Добавить(Товар);
        Если ПакетТоваров.Количество() >= 50 Тогда
            ЗапросКСайту("POST", "integrations/1c/catalog", Ключ, Новый Структура("categories,products", Данные.categories, ПакетТоваров));
            ПакетТоваров = Новый Массив;
        КонецЕсли;
    КонецЦикла;
    Если ПакетТоваров.Количество() > 0 Или Данные.products.Количество() = 0 Тогда
        ЗапросКСайту("POST", "integrations/1c/catalog", Ключ, Новый Структура("categories,products", Данные.categories, ПакетТоваров));
    КонецЕсли;
    Возврат "Каталог отправлен в TEXHORU. Товаров: " + Строка(Данные.products.Количество());
КонецФункции

Функция СохранитьНаблюдение(Данные)
    Если Не Данные.Свойство("id") Или Не Данные.Свойство("oneCId") Или Не Данные.Свойство("price") Тогда
        ВызватьИсключение "В результате мониторинга отсутствуют обязательные поля";
    КонецЕсли;
    Если Не Данные.Свойство("currency") Или Данные.currency <> "RUB" Тогда ВызватьИсключение "Ожидается цена в RUB"; КонецЕсли;
    Если ТипЗнч(Данные.price) <> Тип("Число") Или Данные.price <= 0 Тогда ВызватьИсключение "Некорректная цена конкурента"; КонецЕсли;
    Если СтрДлина(Данные.id) > 100 Тогда ВызватьИсключение "Слишком длинный ID сообщения"; КонецЕсли;
    Товар = Справочники.Товары.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.oneCId));
    ОбъектТовара = Товар.ПолучитьОбъект();
    Если ОбъектТовара = Неопределено Или ОбъектТовара.ПометкаУдаления Тогда ВызватьИсключение "Товар по GUID не найден в этой базе 1С"; КонецЕсли;

    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.МониторингЦенTEXHORU");
        ЭлементБлокировки.УстановитьЗначение("СообщениеID", Данные.id);
        Блокировка.Заблокировать();
        Набор = РегистрыСведений.МониторингЦенTEXHORU.СоздатьНаборЗаписей();
        Набор.Отбор.СообщениеID.Установить(Данные.id);
        Набор.Прочитать();
        Если Набор.Количество() = 0 Тогда
            Запись = Набор.Добавить();
            Запись.СообщениеID = Данные.id;
            Запись.Товар = Товар;
            Запись.Конкурент = Данные.competitor;
            Запись.СсылкаНаТовар = Данные.url;
            Запись.ЦенаКонкурента = Данные.price;
            Запись.СтараяЦена = ?(Данные.oldPrice = Неопределено, 0, Данные.oldPrice);
            Запись.Наличие = ?(Данные.inStock = Истина, "В наличии", ?(Данные.inStock = Ложь, "Нет / под заказ", "Неизвестно"));
            Запись.ДатаПроверкиISO = Данные.checkedAt;
            Запись.РекомендованнаяЦена = ?(Данные.recommendedPrice = Неопределено, 0, Данные.recommendedPrice);
            Запись.Продавец = ?(Данные.seller = Неопределено, "", Данные.seller);
            Запись.Регион = ?(Данные.region = Неопределено, "", Данные.region);
            Запись.ХарактеристикиJSON = ВJSON(Данные.attributes);
            Запись.Получено = ТекущаяДата();
            Набор.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    // Цена и остаток справочника Товары здесь никогда не записываются.
    Возврат Истина;
КонецФункции

Функция ПринятьПакет(Пакет)
    Если Не Пакет.Свойство("schemaVersion") Или Пакет.schemaVersion <> 1 Тогда ВызватьИсключение "Неизвестная версия формата мониторинга"; КонецЕсли;
    Если Не Пакет.Свойство("items") Или ТипЗнч(Пакет.items) <> Тип("Массив") Тогда ВызватьИсключение "Ожидается массив items"; КонецЕсли;
    Квитанции = Новый Массив;
    Для Каждого Наблюдение Из Пакет.items Цикл
        Квитанция = Новый Структура;
        Если Не Наблюдение.Свойство("id") Тогда ВызватьИсключение "Отсутствует ID сообщения"; КонецЕсли;
        Квитанция.Вставить("id", Наблюдение.id);
        Попытка
            СохранитьНаблюдение(Наблюдение);
        Исключение
            Квитанция.Вставить("error", Лев(ОписаниеОшибки(), 1900));
        КонецПопытки;
        Квитанции.Добавить(Квитанция);
    КонецЦикла;
    Возврат Новый Структура("items", Квитанции);
КонецФункции

Функция ПолучитьМониторингИзФайла() Экспорт
    Пакет = ПрочитатьФайлJSON("C:\TEXHORU-Exchange\monitoring.json");
    Квитанции = ПринятьПакет(Пакет);
    ЗаписатьФайлJSON("C:\TEXHORU-Exchange\receipts.json", Квитанции);
    Возврат "Пакет обработан. Подтверждения: C:\TEXHORU-Exchange\receipts.json. Проверь ошибки в этом файле и загрузи его в TEXHORU.";
КонецФункции

Функция ПолучитьМониторингHTTP(Ключ) Экспорт
    Пакет = ЗапросКСайту("GET", "integrations/1c/price-monitor/pending", Ключ);
    Квитанции = ПринятьПакет(Пакет);
    Если Квитанции.items.Количество() > 0 Тогда
        // Сначала сохранение в 1С, затем подтверждение. При обрыве связи пакет можно принять снова.
        ЗапросКСайту("POST", "integrations/1c/price-monitor/receipts", Ключ, Квитанции);
    КонецЕсли;
    Возврат "Пакет мониторинга обработан. Сообщений: " + Строка(Квитанции.items.Количество()) + ". Смотри регистр и журнал обмена TEXHORU. Если очередь не пуста, нажми ещё раз.";
КонецФункции
