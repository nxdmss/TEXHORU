// TEXHORU · Универсальная выборочная выгрузка из УТ 10.3 (TEST).
// Добавь этот текст в модуль формы КОПИИ внешней обработки, без замены старых процедур.
// Реквизиты обычной формы:
//   ГруппаВыгрузки       СправочникСсылка.Номенклатура (выбирать только группу)
//   ВключатьПодгруппы    Булево (по умолчанию Истина)
//   ЛимитВыгрузки        Число (по умолчанию 10; 0 = все подходящие)
//   КлючAPI              существующий реквизит формы
// Кнопка "Выгрузить выбранную группу" -> обработчик ТЕХОРУВыгрузитьГруппуНажатие
// ВСТАВЬ текущий HTTPS-хост ngrok ниже (без https://).
// Только ЧТЕНИЕ данных из 1C. Запись на сайт только после подтверждения.
 
Функция ТЕХОРУПутьГруппы(Группа)
    Части = Новый Массив;
    Уровень = 0;
    Пока ЗначениеЗаполнено(Группа) Цикл
        Если Уровень >= 30 Тогда ВызватьИсключение "Слишком глубокая иерархия"; КонецЕсли;
        Части.Вставить(0, СокрЛП(Группа.Наименование));
        Группа = Группа.Родитель;
        Уровень = Уровень + 1;
    КонецЦикла;
    Результат = "";
    Для Каждого Имя Из Части Цикл
        Если Не ПустаяСтрока(Результат) Тогда Результат = Результат + " / "; КонецЕсли;
        Результат = Результат + Имя;
    КонецЦикла;
    Возврат ?(ПустаяСтрока(Результат), "Без категории", Результат);
КонецФункции

Функция ТЕХОРУБренд(Имя)
    Текст = НРег(Имя);
    Если СтрНайти(Текст, "iphone") > 0 Или СтрНайти(Текст, "apple") > 0 Тогда Возврат "Apple"; КонецЕсли;
    Если СтрНайти(Текст, "samsung") > 0 Или СтрНайти(Текст, "galaxy") > 0 Тогда Возврат "Samsung"; КонецЕсли;
    Если СтрНайти(Текст, "xiaomi") > 0 Или СтрНайти(Текст, "poco") > 0 Или СтрНайти(Текст, "redmi") > 0 Тогда Возврат "Xiaomi"; КонецЕсли;
    Если СтрНайти(Текст, "honor") > 0 Тогда Возврат "Honor"; КонецЕсли;
    Если СтрНайти(Текст, "huawei") > 0 Тогда Возврат "Huawei"; КонецЕсли;
    Возврат "Другие";
КонецФункции

Функция ТЕХОРУСтрокаJSON(Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Функция ТЕХОРУГрупповойПакет(Соединение, Ключ, Товары, КатегорииПоID)
    Категории = Новый Массив;
    Добавленные = Новый Соответствие;
    Для Каждого Товар Из Товары Цикл
        ID = Товар.categoryOneCId;
        Если Добавленные.Получить(ID) = Неопределено Тогда
            Категория = КатегорииПоID.Получить(ID);
            Если Категория = Неопределено Тогда ВызватьИсключение "Неизвестная категория " + ID; КонецЕсли;
            Категории.Добавить(Категория);
            Добавленные.Вставить(ID, Истина);
        КонецЕсли;
    КонецЦикла;
    Пакет = Новый Структура("categories,products", Категории, Товары);
    ЗапросHTTP = Новый HTTPЗапрос("/api/integrations/1c/catalog");
    ЗапросHTTP.Заголовки.Вставить("x-1c-key", Ключ);
    ЗапросHTTP.Заголовки.Вставить("ngrok-skip-browser-warning", "true");
    ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ЗапросHTTP.УстановитьТелоИзСтроки(ТЕХОРУСтрокаJSON(Пакет),
        КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросHTTP);
    Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 201 Тогда
        ВызватьИсключение "Сайт ответил HTTP " + Строка(Ответ.КодСостояния)
            + ": " + Лев(Ответ.ПолучитьТелоКакСтроку(), 600);
    КонецЕсли;
КонецФункции

Процедура ТЕХОРУВыгрузитьГруппуНажатие(Кнопка)
    Попытка
        // Можно выбрать ЛЮБУЮ группу, включая вложенную.
        Если Не ЗначениеЗаполнено(ГруппаВыгрузки) Или Не ГруппаВыгрузки.ЭтоГруппа Тогда
            Сообщить("Укажи группу номенклатуры в поле «Группа выгрузки».");
            Возврат;
        КонецЕсли;
        Если СтрДлина(СокрЛП(КлючAPI)) <> 64 Тогда
            Сообщить("Не заполнен корректный ключ TEXHORU.");
            Возврат;
        КонецЕсли;
        Лимит = ЛимитВыгрузки;
        Если Лимит < 0 Или Лимит > 10000 Тогда
            Сообщить("Лимит: от 0 до 10000; 0 — все товары выбранной ветки.");
            Возврат;
        КонецЕсли;
        Хост = "unimmaculately-unogled-savanna.ngrok-free.dev";
        ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000002");
        Если ТипЦены.Пустая() Или НРег(ТипЦены.Наименование) <> "розничная" Тогда
            ВызватьИсключение "Не найдена розничная цена (код 000000002)";
        КонецЕсли;
        ДатаПроверки = КонецДня(ТекущаяДата());

        // Только выбранный раздел. Подгруппы по отдельному флагу.
        ЗапросОстатков = Новый Запрос;
        ЗапросОстатков.Текст =
        "ВЫБРАТЬ
        |   Остатки.Номенклатура КАК Товар,
        |   СУММА(Остатки.КоличествоОстаток) КАК Остаток
        |ИЗ
        |   РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата) КАК Остатки
        |ГДЕ
        |   НЕ Остатки.Номенклатура.ПометкаУдаления";
        Если ВключатьПодгруппы Тогда
            ЗапросОстатков.Текст = ЗапросОстатков.Текст + "
            |    И Остатки.Номенклатура В ИЕРАРХИИ(&Группа)";
        Иначе
            ЗапросОстатков.Текст = ЗапросОстатков.Текст + "
            |    И Остатки.Номенклатура.Родитель = &Группа";
        КонецЕсли;
        ЗапросОстатков.Текст = ЗапросОстатков.Текст + "
        |СГРУППИРОВАТЬ ПО Остатки.Номенклатура
        |ИМЕЮЩИЕ СУММА(Остатки.КоличествоОстаток) > 0
        |УПОРЯДОЧИТЬ ПО Остатки.Номенклатура";
        ЗапросОстатков.УстановитьПараметр("Дата", ДатаПроверки);
        ЗапросОстатков.УстановитьПараметр("Группа", ГруппаВыгрузки);

        ЗапросЦены = Новый Запрос;
        ЗапросЦены.Текст =
        "ВЫБРАТЬ
        |   Цены.Цена КАК Цена,
        |   Цены.ХарактеристикаНоменклатуры КАК Характеристика
        |ИЗ
        |   РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
        |      &Дата, Номенклатура = &Товар И ТипЦен = &ТипЦен) КАК Цены";
        ЗапросЦены.УстановитьПараметр("Дата", ДатаПроверки);
        ЗапросЦены.УстановитьПараметр("ТипЦен", ТипЦены);

        ВсеТовары = Новый Массив;
        КатегорииПоID = Новый Соответствие;
        БезЦены = 0;
        БезВарианта = 0;
        Пример = "";
        Выборка = ЗапросОстатков.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            // Как в проверенной Apple-выгрузке: базовая розничная цена
            // без характеристики. Варианты не объединяем в один SKU.
            ЗапросЦены.УстановитьПараметр("Товар", Выборка.Товар);
            Цены = ЗапросЦены.Выполнить().Выбрать();
            Цена = 0;
            БылВариант = Ложь;
            Пока Цены.Следующий() Цикл
                Если ЗначениеЗаполнено(Цены.Характеристика) Тогда
                    БылВариант = Истина;
                ИначеЕсли Цены.Цена > 0 Тогда
                    Цена = Цены.Цена;
                КонецЕсли;
            КонецЦикла;
            Если Цена <= 0 Тогда
                БезЦены = БезЦены + 1;
                Если БылВариант Тогда БезВарианта = БезВарианта + 1; КонецЕсли;
                Продолжить;
            КонецЕсли;
            Остаток = Цел(Выборка.Остаток);
            Если Остаток <= 0 Тогда Продолжить; КонецЕсли;

            Товар = Выборка.Товар;
            Группа = Товар.Родитель;
            IDГруппы = Строка(Группа.УникальныйИдентификатор());
            Если КатегорииПоID.Получить(IDГруппы) = Неопределено Тогда
                Категория = Новый Структура;
                Категория.Вставить("oneCId", IDГруппы);
                Категория.Вставить("name", ТЕХОРУПутьГруппы(Группа));
                Категория.Вставить("slug", "1c-" + НРег(IDГруппы));
                КатегорииПоID.Вставить(IDГруппы, Категория);
            КонецЕсли;
            ID = Строка(Товар.УникальныйИдентификатор());
            Данные = Новый Структура;
            Данные.Вставить("oneCId", ID);
            Данные.Вставить("sku", "1C-" + ID);
            Данные.Вставить("slug", "1c-" + ID);
            Данные.Вставить("name", СокрЛП(Товар.Наименование));
            Данные.Вставить("brand", ТЕХОРУБренд(Товар.Наименование));
            Данные.Вставить("categoryOneCId", IDГруппы);
            Данные.Вставить("price", Цел(Цена));
            Данные.Вставить("stockQty", Остаток);
            Если ЗначениеЗаполнено(Товар.Артикул) Тогда
                Данные.Вставить("mpn", Лев(СокрЛП(Товар.Артикул), 100));
            КонецЕсли;
            ВсеТовары.Добавить(Данные);
            Если ВсеТовары.Количество() <= 10 Тогда
                Пример = Пример + Символы.ПС + СокрЛП(Товар.Наименование)
                    + " — " + Строка(Цел(Цена)) + " руб.";
            КонецЕсли;
            Если Лимит > 0 И ВсеТовары.Количество() >= Лимит Тогда Прервать; КонецЕсли;
        КонецЦикла;

        Сообщить("Раздел: " + ТЕХОРУПутьГруппы(ГруппаВыгрузки));
        Сообщить("Вложенные группы: " + ?(ВключатьПодгруппы, "Да", "Нет"));
        Сообщить("К отправке: " + Строка(ВсеТовары.Количество())
            + "; без базовой цены: " + Строка(БезЦены)
            + "; только с характеристиками: " + Строка(БезВарианта));
        Если ВсеТовары.Количество() = 0 Тогда Возврат; КонецЕсли;
        Сообщить("Первые позиции:" + Пример);
        Решение = Вопрос("Выгрузить " + Строка(ВсеТовары.Количество())
            + " товаров из выбранного раздела в TEXHORU? 1С не изменится.",
            РежимДиалогаВопрос.ДаНет);
        Если Решение <> КодВозвратаДиалога.Да Тогда
            Сообщить("Выгрузка отменена."); Возврат;
        КонецЕсли;
        Соединение = Новый HTTPСоединение(
            Хост, 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
        Отправлено = 0;
        Пока Отправлено < ВсеТовары.Количество() Цикл
            Пакет = Новый Массив;
            Пока Отправлено + Пакет.Количество() < ВсеТовары.Количество()
                И Пакет.Количество() < 50 Цикл
                Пакет.Добавить(ВсеТовары[Отправлено + Пакет.Количество()]);
            КонецЦикла;
            ТЕХОРУГрупповойПакет(Соединение, КлючAPI, Пакет, КатегорииПоID);
            Отправлено = Отправлено + Пакет.Количество();
            Сообщить("TEXHORU: выгружено " + Строка(Отправлено)
                + " из " + Строка(ВсеТовары.Количество()));
        КонецЦикла;
        Сообщить("ГОТОВО. Выбранная группа выгружена: " + Строка(Отправлено));
    Исключение
        Сообщить("TEXHORU ошибка выгрузки: " + ОписаниеОшибки());
        Сообщить("Ранее отправленные пакеты останутся на сайте. Повторная выгрузка безопасно обновит те же GUID.");
    КонецПопытки;
КонецПроцедуры
