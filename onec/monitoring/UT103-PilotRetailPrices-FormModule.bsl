// TEXHORU: ПИЛОТ ДВУСТОРОННЕГО ОБМЕНА ЦЕНАМИ, УТ 10.3, ТОЛЬКО TEST
// Вставляется целиком в модуль ОБЫЧНОЙ основной формы отдельной внешней обработки (.epf) для тестовой УТ 10.3.
// Рабочую базу base НЕ использовать. В конфигурацию типовой УТ изменения НЕ вносятся.
//
// ПОДГОТОВКА:
// 1. Выгрузить на сайт до 30 выбранных товаров из тестовой 1С.
// 2. Активировать их GUID через POST /api/integrations/1c/price-sync/scope.
// 3. Для ручной проверки можно вызвать ПилотТЕХОРУПолучитьЦеныДляАгента("ИМЯ.ngrok-free.dev", КлючAPI).
// 4. Для автоматической работы собери EPF и настрой задачу Windows по инструкции onec/agent/README.md.
// 5. Сначала проверь документ УстановкаЦенНоменклатуры и регистр ЦеныНоменклатуры в копии базы.
//
// Защита: до 30 разрешённых GUID, тип цены "Розничная" (000000002),
// проверка expectedPrice, без изменений закупочных цен, с подтверждением после проведения.
// При неоднозначной характеристике или отсутствии розничной цены выполнение прерывается.
Процедура КнопкаВыполнитьНажатие(Кнопка)
    Сообщить("Эта обработка запускается агентом TEXHORU автоматически.");
КонецПроцедуры

Функция ПилотТЕХОРУВJSON(Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции
Функция ПилотТЕХОРУИзJSON(ТекстJSON)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции
Функция ПилотТЕХОРУHTTP(Хост, КлючAPI, Метод, Путь, Тело = Неопределено)
    Если ПустаяСтрока(СокрЛП(Хост)) Тогда
        ВызватьИсключение "Укажи HTTPS-хост TEXHORU, без https://";
    КонецЕсли;
    Если ПустаяСтрока(СокрЛП(КлючAPI)) Тогда
        ВызватьИсключение "Не указан ONE_C_API_KEY";
    КонецЕсли;
    // Не передавай сюда полный URL, только хост.
    Если СтрНайти(Хост, "/") > 0 Или СтрНайти(Хост, ":") > 0 Тогда
        ВызватьИсключение "Хост должен быть без схемы и пути";
    КонецЕсли;
    Соединение = Новый HTTPСоединение(
        Хост, 443, "", "", Неопределено, 40, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/api/" + Путь);
    Запрос.Заголовки.Вставить("x-1c-key", КлючAPI);
    Запрос.Заголовки.Вставить("ngrok-skip-browser-warning", "true");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Если Тело <> Неопределено Тогда
        Запрос.УстановитьТелоИзСтроки(ПилотТЕХОРУВJSON(Тело), КодировкаТекста.UTF8);
    КонецЕсли;
    Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        ВызватьИсключение "TEXHORU HTTP " + Строка(Ответ.КодСостояния)
            + ": " + Лев(Ответ.ПолучитьТелоКакСтроку(), 600);
    КонецЕсли;
    Возврат ПилотТЕХОРУИзJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция ПилотТЕХОРУТипЦены()
    ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000002");
    Если Не ЗначениеЗаполнено(ТипЦены)
        Или НРег(СокрЛП(ТипЦены.Наименование)) <> "розничная" Тогда
        ВызватьИсключение "Розничная цена 000000002 не найдена — запись запрещена";
    КонецЕсли;
    Возврат ТипЦены;
КонецФункции

Функция ПилотТЕХОРУНоменклатура(СтрокаGUID)
    Попытка
        Ссылка = Справочники.Номенклатура.ПолучитьСсылку(
            Новый УникальныйИдентификатор(СтрокаGUID));
    Исключение
        ВызватьИсключение "Некорректный GUID номенклатуры";
    КонецПопытки;
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "Номенклатура по GUID не найдена в тестовой 1С";
    КонецЕсли;
    Если Объект.ЭтоГруппа Или Объект.ПометкаУдаления Тогда
        ВызватьИсключение "Группа или удалённая номенклатура: запись запрещена";
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

// Читаем только ОДНУ однозначную цену по выбранному типу.
// Если одна номенклатура имеет несколько характеристик, требуется
// явный GUID характеристики в контракте — ничего автоматически не выбираем.
Функция ПилотТЕХОРУТекущаяЦена(Номенклатура, ТипЦены)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Цены.Цена КАК Цена,
    |    Цены.ХарактеристикаНоменклатуры КАК Характеристика
    |ИЗ
    |    РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
    |        &Момент,
    |        Номенклатура = &Номенклатура И ТипЦен = &ТипЦен) КАК Цены";
    Запрос.УстановитьПараметр("Момент", ТекущаяДата());
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("ТипЦен", ТипЦены);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Розничная цена в 1С ещё не установлена";
    КонецЕсли;
    Результат = Новый Структура("Цена,Характеристика",
        Выборка.Цена, Выборка.Характеристика);
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "Несколько характеристик товара. Выбери одну явно";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПилотТЕХОРУПрименитьОднуЦену(Изменение, ТипЦены)
    Если Не Изменение.Свойство("id")
        Или Не Изменение.Свойство("oneCId")
        Или Не Изменение.Свойство("expectedPrice")
        Или Не Изменение.Свойство("targetPrice")
        Или Не Изменение.Свойство("currency") Тогда
        ВызватьИсключение "Неполное сообщение об изменении цены";
    КонецЕсли;
    Если Изменение.currency <> "RUB" Тогда
        ВызватьИсключение "Разрешены только рубли";
    КонецЕсли;
    Если ТипЗнч(Изменение.expectedPrice) <> Тип("Число")
        Или ТипЗнч(Изменение.targetPrice) <> Тип("Число")
        Или Изменение.expectedPrice <= 0
        Или Изменение.targetPrice <= 0
        Или Изменение.targetPrice > 5000000 Тогда
        ВызватьИсключение "Недопустимая цена";
    КонецЕсли;
    Номенклатура = ПилотТЕХОРУНоменклатура(Изменение.oneCId);
    Текущая = ПилотТЕХОРУТекущаяЦена(Номенклатура, ТипЦены);
    // Повтор после потери HTTP-квитанции: если цена уже установлена,
    // не создаём повторный документ.
    Если Окр(Текущая.Цена, 0) = Изменение.targetPrice Тогда
        Возврат Изменение.targetPrice;
    КонецЕсли;
    Если Окр(Текущая.Цена, 0) <> Изменение.expectedPrice Тогда
        ВызватьИсключение "Конфликт: в 1С уже другая цена ("
            + Строка(Текущая.Цена) + "), ожидалось "
            + Строка(Изменение.expectedPrice);
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        // Перед проведением повторно читаем цену.
        Контроль = ПилотТЕХОРУТекущаяЦена(Номенклатура, ТипЦены);
        Если Окр(Контроль.Цена, 0) <> Изменение.expectedPrice Тогда
            ВызватьИсключение "Цена 1С изменилась во время обмена";
        КонецЕсли;

        ДокументЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
        ДокументЦен.Дата = ТекущаяДата();
        ДокументЦен.Комментарий = "TEXHORU TEST: " + Изменение.id;
        СтрокаТипа = ДокументЦен.ТипыЦен.Добавить();
        СтрокаТипа.ТипЦен = ТипЦены;

        Товар = ДокументЦен.Товары.Добавить();
        Товар.Номенклатура = Номенклатура;
        Товар.ХарактеристикаНоменклатуры = Контроль.Характеристика;
        Товар.ТипЦен = ТипЦены;
        // УТ проверяет способ расчёта именно в строке Товары.
        // При программном добавлении строки он не переносится из типа цены автоматически.
        Товар.СпособРасчетаЦены = ТипЦены.СпособРасчетаЦены;
        Товар.Цена = Изменение.targetPrice;
        Товар.Валюта = ТипЦены.ВалютаЦены;
        Товар.ЕдиницаИзмерения = Номенклатура.ЕдиницаХраненияОстатков;
        Товар.ИндексСтрокиТаблицыЦен = 0;

        // Только если документ штатно проводится. В случае ошибки делаем откат.
        ДокументЦен.Записать(РежимЗаписиДокумента.Проведение);
        Проверка = ПилотТЕХОРУТекущаяЦена(Номенклатура, ТипЦены);
        Если Окр(Проверка.Цена, 0) <> Изменение.targetPrice Тогда
            ВызватьИсключение "Документ проведён, но розничная цена не подтверждена";
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Изменение.targetPrice;
КонецФункции

// Подбираем пилотную группу из ТОВАРОВ, УЖЕ ЗАГРУЖЕННЫХ НА САЙТ.
// Для подтверждения пользователь обязан вызвать функцию второй раз с Истина.
// Сначала показать список, не меняя настроек сайта.
Функция ПилотТЕХОРУВыбрать30(Хост, КлючAPI, Подтвердить = Ложь) Экспорт
    Данные = ПилотТЕХОРУHTTP(Хост, КлючAPI, "GET", "products");
    Если ТипЗнч(Данные) <> Тип("Массив") Тогда
        ВызватьИсключение "Сайт не вернул список товаров";
    КонецЕсли;
    Идентификаторы = Новый Массив;
    Список = "";
    Для Каждого Продукт Из Данные Цикл
        Если Идентификаторы.Количество() = 30 Тогда
            Прервать;
        КонецЕсли;
        Если Не Продукт.Свойство("oneCId")
            Или Не ЗначениеЗаполнено(Продукт.oneCId)
            Или Продукт.stockQty <= 0
            Или Продукт.price <= 0 Тогда
            Продолжить;
        КонецЕсли;
        // Не блокируем весь выбор, если одна карточка чужая/не имеет
        // единственной розничной цены в локальной тестовой 1С.
        Попытка
            Номенклатура = ПилотТЕХОРУНоменклатура(Продукт.oneCId);
            Текущая = ПилотТЕХОРУТекущаяЦена(Номенклатура, ПилотТЕХОРУТипЦены());
            Если Окр(Текущая.Цена, 0) <> Продукт.price Тогда
                Продолжить;
            КонецЕсли;
        Исключение
            Продолжить;
        КонецПопытки;
        Идентификаторы.Добавить(Продукт.oneCId);
        Список = Список + Символы.ПС + Строка(Идентификаторы.Количество())
            + ". " + Продукт.name + " — " + Строка(Продукт.price) + " руб.";
    КонецЦикла;
    Если Идентификаторы.Количество() = 0 Тогда
        ВызватьИсключение "Нет товаров с совпадающей розничной ценой 1С."
            + " Сначала выгрузи товары из тестовой базы.";
    КонецЕсли;
    Если Не Подтвердить Тогда
        Возврат "Проверь выбранные товары (" + Строка(Идентификаторы.Количество()) + "):" + Список
            + Символы.ПС
            + "Для включения повтори вызов с третьим параметром Истина.";
    КонецЕсли;
    Ответ = ПилотТЕХОРУHTTP(Хост, КлючAPI, "POST",
        "integrations/1c/price-sync/scope",
        Новый Структура("oneCIds", Идентификаторы));
    Возврат "Пилот включен. Товаров: " + Строка(Ответ.count) + Список;
КонецФункции

// Совместимость с ранее созданными кнопками формы.
Функция ПилотТЕХОРУВыбрать10(Хост, КлючAPI, Подтвердить = Ложь) Экспорт
    Возврат ПилотТЕХОРУВыбрать30(Хост, КлючAPI, Подтвердить);
КонецФункции

// Вызывается по кнопке. Точный URL для 1C:
// GET  /api/integrations/1c/price-sync/pending
// POST /api/integrations/1c/price-sync/receipts
Функция ПилотТЕХОРУПолучитьЦеныДляАгента(Хост, КлючAPI) Экспорт
    ОтветОбласти = ПилотТЕХОРУHTTP(Хост, КлючAPI, "GET",
        "integrations/1c/price-sync/scope");
    Область = ОтветОбласти;
    Если ТипЗнч(ОтветОбласти) = Тип("Структура") Тогда
        Если Не ОтветОбласти.Свойство("value", Область) Тогда
            ВызватьИсключение "API scope: отсутствует массив value";
        КонецЕсли;
    КонецЕсли;
    Если ТипЗнч(Область) <> Тип("Массив") Тогда
        ВызватьИсключение "API scope: ожидался массив";
    КонецЕсли;
    Если Область.Количество() > 30 Тогда
        ВызватьИсключение "Неправильный или слишком большой набор пилотных товаров";
    КонецЕсли;
    Разрешённые = Новый Соответствие;
    Для Каждого СтрокаОбласти Из Область Цикл
        // Проверка каждого GUID по локальной номенклатуре делается при записи.
        Разрешённые.Вставить(СтрокаОбласти.oneCId, Истина);
    КонецЦикла;
    Итог = Новый Структура("protocolVersion,ok,applied,failed,processed,batches", 2, Истина, 0, 0, 0, 0);
    // Не более 30 позиций за сеанс. При ошибке останавливаем пакеты,
    // чтобы оставшийся PENDING не повторялся в этом же сеансе.
    Для НомерПакета = 1 По 3 Цикл
        Пакет = ПилотТЕХОРУHTTP(Хост, КлючAPI, "GET",
            "integrations/1c/price-sync/pending");
        Если Не Пакет.Свойство("items") Тогда
            ВызватьИсключение "Неправильная очередь пилотных цен";
        КонецЕсли;
        Если ТипЗнч(Пакет.items) <> Тип("Массив") Тогда
            ВызватьИсключение "Очередь items должна быть массивом";
        КонецЕсли;
        Если Пакет.items.Количество() > 10 Тогда
            ВызватьИсключение "Пакет содержит более 10 изменений";
        КонецЕсли;
        Если Пакет.items.Количество() = 0 Тогда
            Прервать;
        КонецЕсли;
        Квитанции = Новый Массив;
        Для Каждого Изменение Из Пакет.items Цикл
            Квитанция = Новый Структура("id", Изменение.id);
            Попытка
                Если Разрешённые.Получить(Изменение.oneCId) <> Истина Тогда
                    ВызватьИсключение "GUID товара отсутствует в разрешённой группе";
                КонецЕсли;
                ПодтвержденнаяЦена = ПилотТЕХОРУПрименитьОднуЦену(
                    Изменение, ПилотТЕХОРУТипЦены());
                Квитанция.Вставить("appliedPrice", ПодтвержденнаяЦена);
            Исключение
                Квитанция.Вставить("error", Лев(ОписаниеОшибки(), 950));
            КонецПопытки;
            Квитанции.Добавить(Квитанция);
        КонецЦикла;
        // Успех считаем только после подтверждения сервером, а не по числу попыток.
        ОтветКвитанций = ПилотТЕХОРУHTTP(Хост, КлючAPI, "POST",
            "integrations/1c/price-sync/receipts", Новый Структура("items", Квитанции));
        Если Не ОтветКвитанций.Свойство("results") Тогда
            ВызватьИсключение "Сервер не подтвердил квитанции";
        КонецЕсли;
        Если ТипЗнч(ОтветКвитанций.results) <> Тип("Массив") Тогда
            ВызватьИсключение "Неверный ответ на квитанции";
        КонецЕсли;
        Если ОтветКвитанций.results.Количество() <> Квитанции.Количество() Тогда
            ВызватьИсключение "Сервер подтвердил не все квитанции";
        КонецЕсли;
        Для Индекс = 0 По Квитанции.Количество() - 1 Цикл
            Результат = ОтветКвитанций.results[Индекс];
            Если Результат.id <> Квитанции[Индекс].id Тогда
                ВызватьИсключение "Идентификатор квитанции не совпал";
            КонецЕсли;
            Если Результат.status = "DELIVERED" И Не Квитанции[Индекс].Свойство("error") Тогда
                Итог.applied = Итог.applied + 1;
            Иначе
                Итог.failed = Итог.failed + 1;
            КонецЕсли;
            Итог.processed = Итог.processed + 1;
        КонецЦикла;
        Итог.batches = Итог.batches + 1;
        Если Итог.failed > 0 Тогда
            Итог.ok = Ложь;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Возврат Итог;
КонецФункции

// Автоматический запуск через планировщик Windows.
// Параметр запуска: /C "TEXHORU_AGENT|<путь к временному файлу настроек>".
// При обычном ручном открытии обработки этот код ничего не запускает.
Функция ПилотТЕХОРУПрочитатьНастройкиАгента(ПутьФайла)
    Документ = Новый ТекстовыйДокумент;
    Документ.Прочитать(ПутьФайла, КодировкаТекста.UTF8);
    Настройки = ПилотТЕХОРУИзJSON(Документ.ПолучитьТекст());

    Хост = "";
    КлючAPI = "";
    ВидБазы = "";
    НазваниеБазы = "";
    Если Не Настройки.Свойство("host", Хост)
        Или Не Настройки.Свойство("apiKey", КлючAPI)
        Или Не Настройки.Свойство("baseKind", ВидБазы)
        Или Не Настройки.Свойство("baseLabel", НазваниеБазы) Тогда
        ВызватьИсключение "В настройках агента не хватает обязательных полей";
    КонецЕсли;
    Если ВидБазы <> "TEST" Тогда
        ВызватьИсключение "Запуск запрещён: агент работает только с тестовой базой 1С";
    КонецЕсли;
    НазваниеБазы = НРег(НазваниеБазы);
    Если СтрНайти(НазваниеБазы, "тест") = 0
        И СтрНайти(НазваниеБазы, "test") = 0
        И СтрНайти(НазваниеБазы, "копия") = 0
        И СтрНайти(НазваниеБазы, "пилот") = 0
        И СтрНайти(НазваниеБазы, "pilot") = 0
        И СтрНайти(НазваниеБазы, "demo") = 0 Тогда
        ВызватьИсключение "Запуск запрещён: название базы не подтверждает, что это тестовая копия";
    КонецЕсли;
    Если ПустаяСтрока(Хост) Или ПустаяСтрока(КлючAPI) Тогда
        ВызватьИсключение "Не указан адрес TEXHORU или ключ тестового обмена";
    КонецЕсли;
    Возврат Новый Структура("host,apiKey,baseKind", Хост, КлючAPI, ВидБазы);
КонецФункции
Процедура ПилотТЕХОРУЗаписатьРезультатАгента(ПутьНастроек, ТекстРезультата)
    ПутьРезультата = СтрЗаменить(ПутьНастроек, "agent-runtime-", "agent-result-");
    ПутьРезультата = СтрЗаменить(ПутьРезультата, ".json", ".txt");
    Если ПутьРезультата = ПутьНастроек Тогда
        ВызватьИсключение "Неверный путь файла результата агента";
    КонецЕсли;
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(ПилотТЕХОРУВJSON(ТекстРезультата));
    Документ.Записать(ПутьРезультата, КодировкаТекста.UTF8);
КонецПроцедуры
Процедура ПриОткрытии(Отказ)
    Если Не ЗначениеЗаполнено(ПараметрЗапуска) Тогда
        Возврат;
    КонецЕсли;

    ЧастиПараметра = СтрРазделить(ПараметрЗапуска, "|");
    Если ЧастиПараметра.Количество() <> 2
        Или ЧастиПараметра[0] <> "TEXHORU_AGENT" Тогда
        Возврат;
    КонецЕсли;

    ПутьНастроек = ЧастиПараметра[1];
    Попытка
        ПараметрыАгентаТЕХОРУ = ПилотТЕХОРУПрочитатьНастройкиАгента(ПутьНастроек);
        Результат = ПилотТЕХОРУПолучитьЦеныДляАгента(ПараметрыАгентаТЕХОРУ.host, ПараметрыАгентаТЕХОРУ.apiKey);
        ПилотТЕХОРУЗаписатьРезультатАгента(ПутьНастроек, Результат);
    Исключение
        Попытка
            ПилотТЕХОРУЗаписатьРезультатАгента(ПутьНастроек,
                Новый Структура("protocolVersion,ok,applied,failed,processed,batches,error",
                    2, Ложь, 0, 0, 0, 0, Лев(ОписаниеОшибки(), 950)));
        Исключение
            Сообщить("TEXHORU: не удалось записать журнал агента. " + ОписаниеОшибки());
        КонецПопытки;
    КонецПопытки;

    // Один запуск обрабатывает очередь и закрывает 1С.
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

