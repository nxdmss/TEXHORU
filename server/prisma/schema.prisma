generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MANAGER
  DIRECTOR
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum StockState {
  IN_STOCK
  LOW
  PREORDER
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  ASSEMBLING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  ON_RECEIPT
}

enum DeliveryMethod {
  PICKUP
  COURIER
}

enum SyncDirection {
  FROM_1C
  TO_1C
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  name         String
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  auditLogs    AuditLog[]
}

model Category {
  id        String    @id @default(cuid())
  oneCId    String?   @unique
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           Int           @id @default(autoincrement())
  oneCId       String?       @unique
  sku          String        @unique
  slug         String        @unique
  name         String
  brand        String
  description  String        @default("")
  shortSpec    String        @default("")
  image        String        @default("")
  price        Int
  oldPrice     Int?
  stockQty     Int           @default(0)
  reservedQty  Int           @default(0)
  stockState   StockState    @default(IN_STOCK)
  status       ProductStatus @default(ACTIVE)
  badge        String?
  warranty     String        @default("")
  deliveryNote String        @default("")
  specs        Json          @default("[]")
  gtin         String?
  mpn          String?
  attributes   Json          @default("{}")
  costPrice    Int?
  priceSyncEnabled Boolean @default(false)
  oneCPriceChanges OneCPriceChange[]
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orderItems   OrderItem[]
  competitorLinks CompetitorProduct[]

  @@index([categoryId, status])
  @@index([brand])
  @@index([updatedAt])
}

model Order {
  id                    String         @id @default(cuid())
  number                Int            @unique @default(autoincrement())
  trackingToken         String         @unique @default(uuid())
  idempotencyKey        String         @unique
  userId                String?
  user                   User?          @relation(fields: [userId], references: [id])
  customerName          String
  customerPhone         String
  customerEmail         String?
  deliveryMethod        DeliveryMethod @default(PICKUP)
  deliveryAddress       String
  paymentMethod         PaymentMethod  @default(ON_RECEIPT)
  comment               String?
  status                OrderStatus    @default(NEW)
  paymentStatus         PaymentStatus  @default(NOT_STARTED)
  total                  Int
  oneCId                 String?        @unique
  oneCSyncedAt           DateTime?
  reservationReleasedAt DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  items                  OrderItem[]
  payments               Payment[]

  @@index([status, createdAt])
  @@index([oneCSyncedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId Int
  sku       String
  name      String
  price     Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  provider   String
  externalId String?       @unique
  amount     Int
  status     PaymentStatus @default(PENDING)
  payload    Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PromoBanner {
  id        String   @id @default(cuid())
  kicker    String
  title     String
  body      String
  ctaLabel  String
  category  String
  image     String
  tone      String   @default("light")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model SyncLog {
  id        String        @id @default(cuid())
  direction SyncDirection
  entity    String
  entityId  String?
  status    SyncStatus
  message   String?
  payload   Json?
  createdAt DateTime      @default(now())

  @@index([direction, status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model CompetitorSource {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  baseUrl   String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  CompetitorProduct[]
}

model CompetitorProduct {
  id            String                   @id @default(cuid())
  sourceId      String
  source        CompetitorSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalUrl   String                   @unique
  externalName  String?
  externalSku   String?
  attributes    Json                     @default("{}")
  seller        String?
  region        String?
  priceSource   String?
  matchStatus   String                   @default("UNMATCHED")
  confirmedFingerprint String?
  confirmedProductFingerprint String?
  confirmedAt   DateTime?
  lastSuccessAt DateTime?
  latestPrice   Int?
  oldPrice      Int?
  inStock       Boolean?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  history       CompetitorPriceHistory[]

  @@index([sourceId])
  @@index([productId])
  @@index([lastCheckedAt])
}

// Discovered public catalog titles and URLs. No unverified price is stored here.
// Durable across application restarts; never mixed with verified price observations.
model CompetitorCatalogEntry {
  id          String   @id @default(cuid())
  externalUrl String   @unique
  title       String
  model       String?
  storage     String?
  color       String?
  lastSeenAt  DateTime @default(now())

  @@index([model, storage])
  @@index([lastSeenAt])
}

model CompetitorPriceHistory {
  id                  String            @id @default(cuid())
  competitorProductId String
  competitorProduct   CompetitorProduct @relation(fields: [competitorProductId], references: [id], onDelete: Cascade)
  price               Int
  oldPrice            Int?
  inStock             Boolean?
  checkedAt           DateTime          @default(now())
  createdAt           DateTime          @default(now())

  @@index([competitorProductId, checkedAt])
}

// Immutable observations sent to 1C. Retried until acknowledgement by message id.
model MonitorDelivery {
  id          String   @id @default(cuid())
  historyId   String   @unique
  linkId      String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  deliveredAt DateTime?
  @@index([status, createdAt])
}

// One persistent local worker. Every completed card advances the stored cursor.
model MonitorJob {
  id          String   @id @default(cuid())
  kind        String
  status      String   @default("QUEUED")
  url         String?
  page        Int      @default(0)
  maxPages    Int      @default(1)
  perPage     Int      @default(24)
  pendingUrls Json     @default("[]")
  visitedUrls Json     @default("[]")
  processed   Int      @default(0)
  errors      Int      @default(0)
  lastError   String?
  leaseUntil  DateTime?
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  @@index([status, createdAt])
}

model MonitorSettings {
  id              String   @id @default("05ru")
  catalogUrl      String   @default("https://05.ru/cat/c/02e38f8a/telefony_i_gadzety/")
  intervalMinutes Int      @default(0)
  nextRunAt       DateTime?
}

/**
 * Opt-in site-to-1C retail-price delivery. No automatic writes outside the chosen demo scope.
 * The receiving 1C agent checks the expected previous price and acknowledges by stable ID.
 */
model OneCPriceChange {
  id          String   @id @default(cuid())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  oneCId      String
  oldPrice    Int
  newPrice    Int
  sourceLinkId String?
  status      String   @default("PENDING")
  lastError   String?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  deliveredAt DateTime?
  @@index([productId, status])
  @@index([status, createdAt])
}
