NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev-local.db
FRONTEND_ORIGIN=http://127.0.0.1:5173
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
JWT_SECRET=dev-only-texhoru-jwt-secret-change-before-production-123456
ADMIN_EMAIL=director@texhoru.local
ADMIN_PASSWORD=ChangeMe123!
ONE_C_API_KEY=local-dev-1c-key-change-before-production
# Reverse retail-price writes are blocked by default.
# TEST and PRODUCTION use separate keys, caches and explicit profiles.
# Production additionally requires its stable source ID and a dedicated opt-in switch.
ONE_C_BASE_KIND=UNSPECIFIED
# TEST writes require both the TEST kind and its switch.
ONE_C_TEST_PRICE_SYNC_ENABLED=false
# PRODUCTION writes are disabled by default. Main-base requests must carry matching kind/ID headers.
ONE_C_PRODUCTION_PRICE_SYNC_ENABLED=false
ONE_C_PRODUCTION_BASE_ID=
# Enabled profile imports are eligible; submitting a price update is an explicit action.
PAYMENT_PROVIDER=mock
ALLOW_DEV_PAYMENT=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MEDIA_STORAGE_DRIVER=local

# Transactional account email. No provider means registration clearly stays unavailable.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Example MAIL_FROM: TEXHORU <account@your-domain.ru>
