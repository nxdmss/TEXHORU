NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev-local.db
FRONTEND_ORIGIN=http://127.0.0.1:5173
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
JWT_SECRET=dev-only-texhoru-jwt-secret-change-before-production-123456
ADMIN_EMAIL=director@texhoru.local
ADMIN_PASSWORD=ChangeMe123!
ONE_C_API_KEY=local-dev-1c-key-change-before-production
# TEST 1C only: both settings must be changed deliberately to auto-approve
# incoming catalog GUIDs for manually selected retail price updates.
# Use a dedicated TEST 1C key; do not turn these on for the production 1C.
ONE_C_BASE_KIND=UNSPECIFIED
# Reverse price changes are blocked unless BOTH values explicitly identify a test setup.
ONE_C_TEST_PRICE_SYNC_ENABLED=false
# Optional: automatically grant the limited test scope to newly imported TEST products.
ONE_C_TEST_AUTO_PRICE_SCOPE=false
PAYMENT_PROVIDER=mock
ALLOW_DEV_PAYMENT=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MEDIA_STORAGE_DRIVER=local
