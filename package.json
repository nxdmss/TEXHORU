{
  "name": "texhoru",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173",
    "dev:backend": "npm --prefix server run start:dev",
    "stop": "node scripts/stop.mjs",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix server run build",
    "build:all": "npm run build && npm run build:api",
    "preview": "vite preview",
    "db:local:generate": "npm --prefix server run prisma:local:generate",
    "db:local:push": "npm --prefix server run prisma:local:push",
    "data:export": "npm --prefix server run data:export",
    "data:import": "npm --prefix server run data:import",
    "test:startup": "node --test tests/startup.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.9",
    "typescript": "5.9.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@fontsource/ibm-plex-sans": "5.2.6"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
